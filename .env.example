# Verdict environment - copy to .env and fill in. Never commit a filled .env.
FLAGSMITH_SERVER_KEY=
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Any OpenAI-compatible endpoint. The live deployment uses Google Gemini:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.1-flash-lite
# Embedding backend for dense/hybrid retrieval: "local" (MiniLM, default) or
# "gemini" (API embeddings + data/index/vectors-gemini.bin; used on serverless).
EMBED_BACKEND=local
EMBED_MODEL=gemini-embedding-001
COOKIE_SECRET=
IP_HASH_SALT=
ADMIN_TOKEN=
DAILY_BUDGET_USD=5
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_REPO_URL=https://github.com/Daimx1214/verdict
BUILD_ID=dev
